rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Prefer the Firebase Admin custom claim. The exact legacy e-mail fallback
    // keeps the established administrator account working until it receives one.
    function isAdmin() {
      return isSignedIn()
        && (
          request.auth.token.get('admin', false) == true
          || request.auth.token.get('email', '') == 'admin@dohahealing.com'
        );
    }

    function validSocialLink(link) {
      return link is map
        && link.keys().hasOnly([
          'id', 'platform', 'labelAr', 'labelEn',
          'destination', 'order', 'active'
        ])
        && link.keys().hasAll([
          'id', 'platform', 'labelAr', 'labelEn',
          'destination', 'order', 'active'
        ])
        && link.id is string && link.id.size() > 0 && link.id.size() <= 120
        && link.platform in [
          'instagram', 'facebook', 'telegram', 'whatsapp', 'youtube',
          'tiktok', 'x', 'linkedin', 'snapchat', 'website', 'custom'
        ]
        && link.labelAr is string && link.labelAr.size() <= 120
        && link.labelEn is string && link.labelEn.size() <= 120
        && link.destination is string
        && link.destination.size() > 0 && link.destination.size() <= 2048
        && link.destination.matches('https://[^\\s]+')
        && link.order is int && link.order >= 0
        && link.active is bool;
    }

    function validSocialLinks(links) {
      return links is list && links.size() <= 5
        && (links.size() <= 0 || validSocialLink(links[0]))
        && (links.size() <= 1 || validSocialLink(links[1]))
        && (links.size() <= 2 || validSocialLink(links[2]))
        && (links.size() <= 3 || validSocialLink(links[3]))
        && (links.size() <= 4 || validSocialLink(links[4]));
    }

    function validSiteSettingsWrite() {
      let next = request.resource.data;
      let oldRevision = resource == null ? 0 : resource.data.get('socialLinksRevision', 0);
      let socialLinksChanged = resource == null
        ? next.keys().hasAny(['socialLinks'])
        : next.diff(resource.data).affectedKeys().hasAny(['socialLinks']);
      let revisionChanged = resource == null
        ? next.keys().hasAny(['socialLinksRevision'])
        : next.diff(resource.data).affectedKeys().hasAny(['socialLinksRevision']);
      return (!next.keys().hasAny(['socialLinks']) || validSocialLinks(next.socialLinks))
        && (!next.keys().hasAny(['socialLinksRevision'])
          || (next.socialLinksRevision is int && next.socialLinksRevision >= 0))
        && (
          (!socialLinksChanged && !revisionChanged)
          || (
            socialLinksChanged
            && revisionChanged
            && next.socialLinksRevision == oldRevision + 1
          )
        );
    }

    match /siteSettings/config {
      allow read: if true;
      allow create, update: if isAdmin() && validSiteSettingsWrite();
      allow delete: if isAdmin();
    }

    match /items/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contentCategories/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /articles/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adSlides/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /reviews/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/adSlider {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow create, update: if false;
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}